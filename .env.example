# Copy to .env and adjust secrets before production use.
APP_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/fortuner.db
# DATABASE_URL=postgresql+psycopg2://fortuner:fortuner@localhost:5432/fortuner

DASHBOARD_USERNAME=buyer
DASHBOARD_PASSWORD=fortuner

COLLECTOR_MODE=fixture
ENABLE_SCHEDULER=true
ALERT_PROVIDER=log

MAX_PRICE_ZAR=700000
STRETCH_PRICE_ZAR=725000
MAX_MILEAGE_KM=100000
STRETCH_MILEAGE_KM=110000

MARKETPLACE_INTERVAL_SECONDS=10800
DEAL_SCORE_ALERT_THRESHOLD=80
PRICE_REDUCTION_ALERT_ZAR=10000

# Email (optional)
# ALERT_PROVIDER=email
# ALERT_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=fortuner-agent@example.com

